<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.leyan.bill-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/leyan/Code/财务统计/.venv/bin/python</string>
        <string>/Users/leyan/Code/财务统计/src/daily.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/leyan/Code/财务统计</string>

    <!-- 每天早上 09:07 触发（错开整点） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>7</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/leyan/Code/财务统计/logs/daily.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/leyan/Code/财务统计/logs/daily.err.log</string>

    <!-- 错过触发时间（如关机），开机后补跑一次 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
