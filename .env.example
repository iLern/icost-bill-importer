# QQ 邮箱 IMAP：MAIL_USER 填邮箱地址，MAIL_AUTHCODE 填 IMAP 授权码（非登录密码）
# 授权码获取：QQ邮箱网页端 → 设置 → 账户 → 开启 IMAP/SMTP 服务 → 生成授权码
MAIL_USER=your_qq@qq.com
MAIL_AUTHCODE=your_imap_authcode

# LLM（与 main.py 共用）
OPENAI_API_URL=https://your-llm-gateway/v1
OPENAI_API_KEY=your_api_key
# 模型名（可选，默认 deepseek-ai/DeepSeek-V3.2）
OPENAI_MODEL=deepseek-ai/DeepSeek-V3.2
